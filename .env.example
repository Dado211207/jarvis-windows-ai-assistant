ANTHROPIC_API_KEY=
JARVIS_HOST=127.0.0.1
JARVIS_PORT=5555
# Leave unset to use the default location automatically (repo-relative in
# development, %LOCALAPPDATA%\JARVIS\data\ in the packaged app — see
# app/core/app_paths.py). Set explicitly only to override either mode:
JARVIS_DB_PATH=
JARVIS_LOG_LEVEL=INFO
# Same default-vs-override rule as JARVIS_DB_PATH above:
JARVIS_LOG_FILE=

# AI provider settings
# JARVIS_AI_PROVIDER is the STARTING default only: a provider chosen on the
# Settings page is saved to config/preferences.json and wins from then on.
# Valid values: anthropic, ollama.
JARVIS_AI_PROVIDER=anthropic
JARVIS_AI_MODEL=
JARVIS_AI_MAX_TOKENS=250
# A per-request timeout — how long to wait for the connection and for the
# next chunk of a streamed reply. Not a cap on how long an answer may be.
JARVIS_AI_TIMEOUT_SECONDS=20

# Local Ollama model, e.g. llama3:latest. Empty means "use whichever model
# the local instance reports first". A model already installed in Ollama
# appears in Settings; JARVIS can also download one, but only from
# Settings -> Local AI, only when a person presses the button, and only
# after showing the source, publisher, licence, size and this machine's
# free space. Nothing is fetched on startup or as a side effect.
# Ollama is contacted on 127.0.0.1:11434 only — there is deliberately no
# setting for a remote host.
JARVIS_OLLAMA_MODEL=

# TTS / voice output settings (Phase 3)
# Set JARVIS_TTS_ENABLED=true to enable voice output (local/offline, pyttsx3)
JARVIS_TTS_ENABLED=false
JARVIS_TTS_ENGINE=pyttsx3
JARVIS_TTS_RATE=175
JARVIS_TTS_VOLUME=1.0
JARVIS_TTS_VOICE=

# STT / push-to-talk voice input (v0.2). Push-to-talk only — no wake word,
# no always-listening.
#
# Offered by default. Unlike spoken output, voice input cannot capture
# anything until a button is held in the UI and the OS grants microphone
# permission, so this flag decides whether the feature is *offered*, not
# whether the microphone is open. The Voice page can switch it off, and
# that saved choice wins over this value.
#
# The Windows installer bundles the speech engine. From source, install
# it with `pip install -r requirements-voice.txt`; without it the Voice
# page says so plainly and text input works as normal.
JARVIS_STT_ENABLED=true
JARVIS_STT_MODEL_SIZE=tiny
# Point at an already-downloaded local model to guarantee no network call:
JARVIS_STT_MODEL_PATH=
# Must be explicitly true to let faster-whisper download JARVIS_STT_MODEL_SIZE
# from Hugging Face Hub when no local JARVIS_STT_MODEL_PATH is set:
JARVIS_STT_ALLOW_DOWNLOAD=false
JARVIS_STT_TIMEOUT_SECONDS=30
