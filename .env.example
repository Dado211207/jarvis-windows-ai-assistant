ANTHROPIC_API_KEY=
JARVIS_HOST=127.0.0.1
JARVIS_PORT=5555
JARVIS_DB_PATH=data/jarvis.db
JARVIS_LOG_LEVEL=INFO

# AI / Claude settings (Phase 2)
JARVIS_AI_PROVIDER=anthropic
JARVIS_AI_MODEL=
JARVIS_AI_MAX_TOKENS=250
JARVIS_AI_TIMEOUT_SECONDS=20

# TTS / voice output settings (Phase 3)
# Set JARVIS_TTS_ENABLED=true to enable voice output (local/offline, pyttsx3)
JARVIS_TTS_ENABLED=false
JARVIS_TTS_ENGINE=pyttsx3
JARVIS_TTS_RATE=175
JARVIS_TTS_VOLUME=1.0
JARVIS_TTS_VOICE=

# STT / push-to-talk voice input (v0.2). Push-to-talk only — no wake word,
# no always-listening. Requires `pip install -r requirements-voice.txt`
# separately; the app runs fine without it (text input always works).
JARVIS_STT_ENABLED=false
JARVIS_STT_MODEL_SIZE=tiny
# Point at an already-downloaded local model to guarantee no network call:
JARVIS_STT_MODEL_PATH=
# Must be explicitly true to let faster-whisper download JARVIS_STT_MODEL_SIZE
# from Hugging Face Hub when no local JARVIS_STT_MODEL_PATH is set:
JARVIS_STT_ALLOW_DOWNLOAD=false
JARVIS_STT_TIMEOUT_SECONDS=30
