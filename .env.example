ANTHROPIC_API_KEY=
JARVIS_HOST=127.0.0.1
JARVIS_PORT=5555
JARVIS_DB_PATH=data/jarvis.db
JARVIS_LOG_LEVEL=INFO

# AI / Claude settings (Phase 2)
JARVIS_AI_PROVIDER=anthropic
JARVIS_AI_MODEL=
JARVIS_AI_MAX_TOKENS=250
JARVIS_AI_TIMEOUT_SECONDS=20

# TTS / voice output settings (Phase 3)
# Set JARVIS_TTS_ENABLED=true to enable voice output (local/offline, pyttsx3)
JARVIS_TTS_ENABLED=false
JARVIS_TTS_ENGINE=pyttsx3
JARVIS_TTS_RATE=175
JARVIS_TTS_VOLUME=1.0
JARVIS_TTS_VOICE=

# Phase 8: Persistent user settings & personality memory
# Safe preferences (your name, assistant name, language, response style, tone,
# theme, TTS rate/volume, pinned commands) now persist across restarts in the
# local SQLite database — set them on the Settings page or with commands like
# "set assistant name to JARVIS". They are NOT configured here.
# Secrets and API keys are never stored in settings or memory — only in this file.
