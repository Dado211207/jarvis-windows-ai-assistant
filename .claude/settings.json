{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "dado-tools": {
      "source": {
        "source": "github",
        "repo": "Dado211207/dado-claude-toolkit"
      }
    }
  },
  "enabledPlugins": {
    "dado-core@dado-tools": true,
    "dado-python-windows@dado-tools": true,
    "dado-release-safety@dado-tools": true
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.pfx)",
      "Read(./**/*.p12)",
      "Read(./**/.pypirc)",
      "Read(./**/.git-credentials)",
      "Read(./**/credentials.json)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(cmdkey *)",
      "Bash(twine upload *)",
      "Bash(python -m twine upload *)",
      "Bash(signtool *)",
      "Bash(gh release *)"
    ]
  }
}
